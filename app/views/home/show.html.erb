<section class="mx-auto max-w-2xl">
  <div class="flex items-center gap-4">
    <% if @user.avatar_url.present? %>
      <%= image_tag @user.avatar_url, alt: "", class: "size-12 rounded-full", referrerpolicy: "no-referrer" %>
    <% end %>
    <h1 class="text-2xl text-fern-900">Welcome, <%= @user.name.presence || @user.email %></h1>
  </div>
</section>
