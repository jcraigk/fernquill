<% content_for :title, "Sign in · Fernquill" %>

<section class="mx-auto max-w-sm text-center">
  <h1 class="text-3xl text-fern-900">Write in your own hand.</h1>
  <p class="mt-3 text-stone-600">A quiet place to draft, revise, and hear your words.</p>

  <%= button_to "Sign in with Google", "/auth/google_oauth2", method: :post, data: { turbo: false },
        class: "mt-8 w-full cursor-pointer rounded-lg bg-fern-700 px-4 py-3 font-sans text-white hover:bg-fern-900" %>
</section>
