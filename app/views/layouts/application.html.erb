<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Fernquill" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Fernquill">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_client_tag %>
    <%= vite_javascript_tag "application" %>
  </head>

  <body class="min-h-screen bg-paper text-stone-800 font-serif">
    <header class="flex items-center justify-between px-6 py-4">
      <%= link_to "🌿🪶 Fernquill", root_path, class: "text-xl text-fern-900" %>
      <% if authenticated? %>
        <%= button_to "Sign out", logout_path, method: :delete,
              class: "text-sm text-stone-500 hover:text-stone-800 cursor-pointer" %>
      <% end %>
    </header>

    <% flash.each do |type, message| %>
      <p class="mx-auto max-w-md rounded bg-amber-50 px-4 py-2 text-sm text-amber-900" data-flash="<%= type %>">
        <%= message %>
      </p>
    <% end %>

    <main class="px-6 py-10">
      <%= yield %>
    </main>
  </body>
</html>
